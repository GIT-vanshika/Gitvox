{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run build:server && npm run build:api",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "build:api": "node scripts/build-api.mjs",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx --test src/services/gitvoxLogic.test.ts src/services/voiceCommands.test.ts src/services/speechRecognition.test.ts src/services/assistantRequest.test.ts src/services/assistantMarkdown.test.ts server/modelClient.test.ts server/assistantClient.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "description": "**Your code. Your voice. Your clarity.**",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIT-vanshika/Gitvox.git"
  },
