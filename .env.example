# GEMINI_API_KEY: Optional server-side API key for live AI model analysis
GEMINI_API_KEY=""

# VITE_ALAN_SDK_KEY: Optional Alan AI SDK key for live voice command recognition
VITE_ALAN_SDK_KEY=""

# ---------------------------------------------------------------------------
# Phase 2: server-side open-weight model (never exposed to the browser)
# ---------------------------------------------------------------------------
# Required. Credential for the OpenAI-compatible provider below.
# For OpenRouter: https://openrouter.ai/settings/keys
MODEL_API_KEY=""

# OpenAI-compatible endpoint. Defaults to OpenRouter.
MODEL_BASE_URL="https://openrouter.ai/api/v1"

# Default: Qwen2.5-Coder-32B-Instruct (open weights, Apache-2.0).
# Other open-weight options on OpenRouter:
#   meta-llama/llama-3.3-70b-instruct
#   deepseek/deepseek-chat
#   qwen/qwen-2.5-72b-instruct
MODEL_NAME="qwen/qwen-2.5-coder-32b-instruct"

# Optional display/provider label and request limits.
MODEL_PROVIDER_LABEL="OpenRouter"
MODEL_TIMEOUT_MS="45000"
MODEL_MAX_OUTPUT_TOKENS="700"

# Optional OpenRouter attribution headers.
MODEL_APP_NAME="Gitvox"
MODEL_APP_URL="http://localhost:3000"

# Express API port. `npm run dev` sets this to 3001 automatically.
# `npm start` defaults to 3000.
PORT=""

# Application base URL
APP_URL="http://localhost:3000"