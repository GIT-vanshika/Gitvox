# ---------------------------------------------------------------------------
# AI Model Configuration (Server-side; never exposed to the browser)
# ---------------------------------------------------------------------------
# Google Gemini API key (recommended: 1M token context, free tier from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Or OpenRouter API key (https://openrouter.ai/settings/keys)
MODEL_API_KEY=""

# Model endpoint and settings (Defaults to Gemini when GEMINI_API_KEY is present)
MODEL_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
MODEL_NAME="gemini-3.1-flash-lite"
MODEL_PROVIDER_LABEL="Google Gemini"
MODEL_TIMEOUT_MS="45000"
MODEL_MAX_OUTPUT_TOKENS="4000"

# Optional OpenRouter attribution headers.
MODEL_APP_NAME="Gitvox"
MODEL_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Voice: browser-native Web Speech API (no key, account, or paid service)
# ---------------------------------------------------------------------------
# Recognition language (BCP-47). English is the initial language.
VITE_SPEECH_LANGUAGE="en-US"

# Express API port. `npm run dev` sets this to 3001 automatically.
# `npm start` defaults to 3000.
PORT=""

# Application base URL
APP_URL="http://localhost:3000"